# Release signing config for the Smith Net Android app.
#
# Copy this file to `android/keystore.properties` (which is gitignored) and fill
# in real values. When the file is absent, the release build still completes but
# is UNSIGNED -- a signed keystore is required before distributing the beta APK.
#
# Generate a keystore once (keep the .jks OUT of git -- *.jks is gitignored):
#   keytool -genkeypair -v \
#     -keystore smithnet-release.jks \
#     -alias smithnet \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/ project root.

storeFile=smithnet-release.jks
storePassword=CHANGE_ME
keyAlias=smithnet
keyPassword=CHANGE_ME
