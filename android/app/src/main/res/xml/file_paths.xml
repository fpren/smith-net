<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Media cache for camera captures, voice recordings, video, and file copies -->
    <cache-path name="media" path="media/" />
    <cache-path name="images" path="media/images/" />
    <cache-path name="voice" path="media/voice/" />
    <cache-path name="video" path="media/video/" />
    <cache-path name="files" path="media/files/" />
    
    <!-- App files -->
    <files-path name="app_files" path="." />
    
    <!-- External files (if needed) -->
    <external-files-path name="external" path="." />

    <!-- Shared invoice / BOL documents written to cache for Intent.ACTION_SEND -->
    <cache-path name="shared-docs" path="shared-docs/" />
</paths>
